# Придумайте сами любую строку — например "kira_secret_2026"
WEBHOOK_VERIFY_TOKEN=your_secret_token_here

# Из Meta Developer Console → Your App → Instagram → Access Tokens
INSTAGRAM_PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here

# Из Meta Developer Console → Your App → Settings → Basic → App Secret
META_APP_SECRET=your_app_secret_here
